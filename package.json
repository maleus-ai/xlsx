{
  "name": "xlsx-workspace",
  "private": true,
  "description": "Workspace root for the XLSX streaming reader",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maleus-ai/xlsx.git"
  },
  "scripts": {
    "fixtures": "node fixtures/generate.mjs",
    "build": "pnpm --filter @maleus/xlsx run build:native",
    "build:debug": "pnpm --filter @maleus/xlsx run build:debug",
    "test": "pnpm --filter @maleus/xlsx run test:native",
    "ci:native": "pnpm --filter @maleus/xlsx run ci:native",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings"
  },
  "packageManager": "pnpm@10.24.0"
}
